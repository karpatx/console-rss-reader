Screen {
  background: $surface;
  color: $text;
  layout: vertical;
}

#header {
  height: auto;
  content-align: left middle;
  background: $boost;
  color: $text;
  border: none;
  padding: 1 2;
  layout: horizontal;
}

#header-text {
  width: 1fr;
}

#language-select {
  width: 15;
  min-width: 15;
}

#search-input {
  height: 3;
  padding: 0 1;
  border: solid $accent;
  background: $surface;
}

#main {
  height: 1fr;
  width: 1fr;
  layout: horizontal;
}

#footer {
  height: 1;
  content-align: left middle;
  padding: 0 1;
  background: $panel;
  color: $text;
  border: none;
}

#sidebar {
  width: 32;
  min-width: 32;
  padding: 1 1;
  background: $panel;
  border: solid $accent;
  layout: vertical;
}

#sidebar Tree {
  width: 1fr;
  height: 1fr;
  overflow: auto;
  border: none;
}

#content {
  width: 1fr;
  height: 1fr;
  layout: vertical;
}

#list {
  height: 1fr;
  overflow: hidden;
  padding: 0 1;
  border: none;
}

#list ListItem {
  overflow: hidden;
  text-overflow: ellipsis;
  text-wrap: nowrap;
}

#list ListItem Static {
  overflow: hidden;
  text-overflow: ellipsis;
  text-wrap: nowrap;
  width: 100%;
}

#detail {
  height: 1fr;
  border: none;
  border-top: solid $accent;
}

#detail:focus {
  border-top: solid $warning;
  border-left: thick $warning;
  border-right: thick $warning;
}

#detail-content {
  padding: 0 1;
}

/* Article modal screen styles */
#article-container {
  width: 90%;
  height: 90%;
  max-width: 120;
  max-height: 50;
  background: $surface;
  border: solid $accent;
  layout: vertical;
  padding: 1;
}

#article-header {
  height: auto;
  content-align: left middle;
  padding: 0 1;
  border: none;
  border-bottom: solid $accent;
  layout: horizontal;
  align: left middle;
}

#article-title {
  width: 1fr;
  content-align: left middle;
}

#close-x-btn {
  width: 3;
  height: 3;
  min-width: 3;
  margin: 0;
  padding: 0;
}

#article-subheader {
  height: auto;
  content-align: left middle;
  padding: 0 1;
  border: none;
}

#article-body {
  height: 1fr;
  padding: 0 1;
  border: none;
}

#article-text {
  padding: 0 1;
  text-align: left;
}

#article-footer {
  height: auto;
  width: 1fr;
  border: none;
  border-top: solid $accent;
  padding: 1;
  layout: horizontal;
}

#article-link {
  content-align: left middle;
  padding: 0 1;
}

ModalScreen #close-btn {
  margin-left: 1;
}

ModalScreen {
  align: center middle;
}

#article-container {
  align: center middle;
}

/* Loading screen styles */
#loading-container {
  width: 40;
  height: 10;
  background: $surface;
  border: solid $accent;
  layout: vertical;
  padding: 2;
  align: center middle;
}

#loading-text {
  content-align: center middle;
  text-align: center;
  padding: 1;
}
